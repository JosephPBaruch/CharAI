classDiagram
    class "User Registration" {
        Endpoint: POST /register
        Description: Creates a new user account. Validates input and generates a JWT token.
        Request Body:
        {
          "username": "string",
          "email": "string",
          "password": "string"
        }
        Response:
        {
          "token": "JWT_TOKEN",
          "message": "Signup successful"
        }
        APIs/Azure Services: Azure SQL Database, Azure AD B2C
    }

    class "User Login" {
        Endpoint: POST /login
        Description: Authenticates an existing user and returns a JWT token.
        Request Body:
        {
          "email": "string",
          "password": "string"
        }
        Response:
        {
          "token": "JWT_TOKEN",
          "message": "Login successful"
        }
        APIs/Azure Services: Azure SQL Database, Azure AD B2C
    }

    class "Manual Land Coordinate Entry" {
        Endpoint: POST /land-coordinates
        Description: Accepts user-provided coordinates, validates them, and returns GeoJSON data for mapping.
        Request Body:
        {
          "coordinates": [
            {"lat": float, "long": float},
            ...
          ]
        }
        Response:
        {
          "geojson": {...}
        }
        APIs/Azure Services: Azure Maps API, Azure Functions
    }

    class "Land File Upload" {
        Endpoint: POST /upload-land
        Description: Uploads .kml or .geojson files to extract field boundaries and returns GeoJSON.
        Request Body: FormData with file attachment (.kml or .geojson)
        Response:
        {
          "geojson": {...},
          "message": "Upload successful"
        }
        APIs/Azure Services: Azure Blob Storage, Azure Functions
    }

    class "Generate Prescription Map" {
        Endpoint: POST /generate-map
        Description: Generates a color-coded prescription map based on field data, soil, slope.
        Request Body:
        {
          "field_coordinates": {...},
          "soil_data": {...},
          "slope_data": {...},
          "moisture_data": {...}
        }
        Response:
        {
          "map_url": "https://storage.azure.com/container/map_id.png",
          "metadata": {
            "map_id": "string",
            "date_created": "YYYY-MM-DD"
          }
        }
        APIs/Azure Services: EOS Data Analytics, Farmonaut, Azure Maps, Azure Blob Storage, Azure SQL Database
    }

    class "Download Map" {
        Endpoint: GET /download-map/{id}
        Description: Fetches a generated map file from storage and streams it to the frontend for download.
        Request Params:
          id: string (Map file ID)
        Response: File stream (.png or .geojson)
        Azure Services: Azure Blob Storage
    }

    class "Notes" {
        Authentication: JWT tokens via Authorization header
        File Storage: Azure Blob Storage with signed/public URLs
        Geo Processing: Azure Functions or Logic Apps
        Yield Prediction: EOS Data Analytics or Farmonaut APIs
    }

    "User Registration" --> "User Login"
    "User Login" --> "Manual Land Coordinate Entry"
    "Manual Land Coordinate Entry" --> "Land File Upload"
    "Land File Upload" --> "Generate Prescription Map"
    "Generate Prescription Map" --> "Download Map"
    "Download Map" --> "Notes"