flowchart TD
    %% --- Node styling definitions ---
    classDef data fill:#e8f1ff,stroke:#1e66f5,stroke-width:1px,color:#0b3b8c;
    classDef proc fill:#eef7ee,stroke:#2a7a2a,stroke-width:1px,color:#174d17;
    classDef out fill:#fff6e6,stroke:#b35c00,stroke-width:1px,color:#7a3d00;

    %% --- Flow ---
    AA[Coordinates]:::data --> B[Model / Equation]:::proc
    AA --> AB[Land Data]:::data
    AC[Biochar Data]:::data --> BB
    AB --> BB[Biochar-Altered Land Data]:::proc
    BB --> B
    B --> C[Output: Yield Prediction]:::out
    C --> D[Biochar Prescription Maps]:::out
